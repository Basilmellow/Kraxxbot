{
  "name": "kraxx-bot",
  "version": "1.0.0",
  "description": "KRAXX - Official Internal Operations Discord Bot for KRAXX HQ (KRAXXSEC & KRAXX STUDIO)",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "deploy:commands": "ts-node scripts/deploy-commands.ts",
    "validate:config": "ts-node scripts/validate-config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "discord",
    "bot",
    "kraxx",
    "kraxxsec",
    "kraxx-studio",
    "operations",
    "typescript",
    "prisma"
  ],
  "author": "KRAXX Engineering",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
