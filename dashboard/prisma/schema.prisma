datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────
// Multi-Tenant Core Architecture (Discord Server = Independent Tenant)
// ─────────────────────────────────────────────────────────────────

model Guild {
  id                     String                  @id // Discord Guild Snowflake ID
  name                   String
  icon                   String?
  ownerId                String
  joinedAt               DateTime                @default(now())
  botInstalled           Boolean                 @default(true)
  settings               GuildSettings?
  modules                GuildModule[]
  roleConfigs            GuildRoleConfig[]
  members                GuildMember[]
  tickets                Ticket[]
  ticketPanels           TicketPanel[]
  tasks                  Task[]
  reminders              Reminder[]
  meetings               Meeting[]
  events                 Event[]
  announcements          Announcement[]
  scheduledAnnouncements ScheduledAnnouncement[]
  embedTemplates         EmbedTemplate[]
  automations            AutomationRule[]
  moderationCases        ModerationCase[]
  auditLogs              AuditLog[]
  dashboardAuditLogs     DashboardAuditLog[]
  welcomeConfig          WelcomeConfig?
  selfRoles              GuildSelfRole[]
  polls                  Poll[]
  suggestions            Suggestion[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([ownerId])
}

model GuildSettings {
  id                         String   @id @default(uuid())
  guildId                    String   @unique
  guild                      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  prefix                     String   @default("/")
  locale                     String   @default("en")
  timezone                   String   @default("UTC")
  adminRoleId                String?
  modRoleId                  String?
  supportRoleId              String?
  staffRoleId                String?
  logChannelId               String?
  modLogChannelId            String?
  welcomeChannelId           String?
  announcementChannelId      String?
  ticketCategoryId           String?
  ticketLogsChannelId        String?
  ticketTranscriptsChannelId String?
  setupCompleted             Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

model GuildModule {
  id        String   @id @default(uuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  module    String   // "tickets" | "moderation" | "welcome" | "tasks" | "reminders" | "meetings" | "embeds" | "automation" | "analytics" | "logging" | "announcements" | "roles"
  enabled   Boolean  @default(true)
  config    String?  // JSON string configuration
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([guildId, module])
  @@index([guildId])
}

model GuildRoleConfig {
  id        String   @id @default(uuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roleId    String
  roleType  String   // "ADMIN" | "MODERATOR" | "SUPPORT" | "STAFF" | "VERIFIED" | "CUSTOM"
  name      String
  createdAt DateTime @default(now())

  @@unique([guildId, roleId])
  @@index([guildId])
}

model GuildMember {
  id            String                    @id @default(uuid())
  guildId       String
  guild         Guild                     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordId     String
  username      String
  displayName   String
  avatar        String?
  isVerified    Boolean                   @default(false)
  verifiedAt    DateTime?
  roleTier      String                    @default("USER") // "ADMIN" | "MODERATOR" | "SUPPORT" | "STAFF" | "USER"
  joinedAt      DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  verifications GuildMemberVerification[]

  @@unique([guildId, discordId])
  @@index([guildId])
  @@index([discordId])
}

model GuildMemberVerification {
  id            String       @id @default(uuid())
  guildId       String
  discordId     String
  verifiedAt    DateTime     @default(now())
  status        String       @default("SUCCESS") // "SUCCESS" | "FAILED" | "ALREADY_VERIFIED"
  notes         String?
  guildMemberId String?
  guildMember   GuildMember? @relation(fields: [guildMemberId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([discordId])
}

model BotHeartbeat {
  id              String   @id @default("singleton")
  status          String   @default("ONLINE") // "ONLINE" | "DEGRADED" | "OFFLINE"
  gatewayStatus   String   @default("CONNECTED") // "CONNECTED" | "DISCONNECTED" | "CONNECTING"
  ping            Int      @default(0) // ms
  uptime          Int      @default(0) // seconds
  guildCount      Int      @default(0)
  schedulerStatus String   @default("RUNNING")
  version         String   @default("2.0.0")
  lastHeartbeat   DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// Support Ticket System (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model TicketPanel {
  id          String   @id @default(uuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String   @default("GENERAL")
  channelId   String
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model Ticket {
  id            String    @id @default(uuid())
  ticketNumber  Int
  guildId       String
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId     String    @unique
  openerId      String
  claimerId     String?
  closedById    String?
  transcriptUrl String?
  category      String    @default("GENERAL")
  subject       String
  reason        String?
  status        String    @default("OPEN") // "OPEN" | "CLAIMED" | "WAITING" | "RESOLVED" | "CLOSED"
  priority      String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  staffNotes    String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, ticketNumber])
  @@index([guildId])
  @@index([guildId, status])
}

// ─────────────────────────────────────────────────────────────────
// Moderation & Safety (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model ModerationCase {
  id              String   @id @default(uuid())
  caseNumber      Int
  guildId         String
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  targetId        String
  targetTag       String?
  moderatorId     String
  moderatorTag    String?
  action          String   // WARN | TIMEOUT | KICK | BAN | UNBAN
  reason          String?
  durationSeconds Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([guildId, targetId])
  @@index([guildId, action])
  @@index([guildId, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Self-Assignable Roles (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model GuildSelfRole {
  id          String   @id @default(uuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roleId      String
  name        String
  description String?
  emoji       String?
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now())

  @@unique([guildId, roleId])
  @@index([guildId])
}

// ─────────────────────────────────────────────────────────────────
// Community & Announcements (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model Announcement {
  id          String   @id @default(uuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  content     String
  department  String   @default("GENERAL")
  type        String   @default("GENERAL") // "GENERAL" | "IMPORTANT" | "EVENT" | "MAINTENANCE"
  authorId    String
  channelId   String
  messageId   String?
  mentionRole String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model ScheduledAnnouncement {
  id            String    @id @default(uuid())
  guildId       String
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId     String
  title         String?
  content       String?
  embedPayload  String?   // JSON string representation of embeds
  mentionType   String?   // "NONE" | "EVERYONE" | "HERE" | "ROLE"
  mentionRoleId String?
  department    String    @default("GENERAL")
  scheduledFor  DateTime
  status        String    @default("PENDING") // "PENDING" | "SENT" | "CANCELLED" | "FAILED"
  createdBy     String    // Discord user ID
  sentAt        DateTime?
  error         String?
  messageId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId])
  @@index([status, scheduledFor])
}

model WelcomeConfig {
  id             String   @id @default(uuid())
  guildId        String   @unique
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  channelId      String?
  message        String?
  embedJson      String?  // JSON embed config
  imageUrl       String?
  roleId         String?  // Auto-assign role on join
  dmEnabled      Boolean  @default(false)
  dmMessage      String?
  leaveChannelId String?
  leaveMessage   String?
  updatedAt      DateTime @updatedAt
}

model EmbedTemplate {
  id          String   @id @default(uuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("CUSTOM")
  description String?
  title       String?
  embedData   String   // JSON string containing full embed specification
  createdBy   String   // Discord user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────
// Operations & Automations (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  taskNumber  Int
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  description String
  department  String    @default("GENERAL")
  status      String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  priority    String    @default("MEDIUM")  // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guildId, taskNumber])
  @@index([guildId])
  @@index([guildId, status])
}

model Reminder {
  id          String    @id @default(uuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  message     String
  targetType  String    @default("USER") // "USER" | "CHANNEL"
  targetId    String
  cronPattern String?
  triggerAt   DateTime?
  isRecurring Boolean   @default(false)
  status      String    @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([guildId])
  @@index([guildId, status])
}

model Meeting {
  id                String    @id @default(uuid())
  guildId           String
  guild             Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title             String
  agenda            String
  department        String    @default("GENERAL")
  startTime         DateTime
  endTime           DateTime?
  locationChannelId String?
  organizerId       String
  attendees         String?   // JSON array string of discord IDs
  status            String    @default("SCHEDULED") // "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  createdAt         DateTime  @default(now())

  @@index([guildId])
  @@index([guildId, status])
}

model Event {
  id          String    @id @default(uuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        String    @default("COMMUNITY")
  department  String    @default("GENERAL")
  startTime   DateTime
  endTime     DateTime?
  location    String?
  organizerId String
  status      String    @default("UPCOMING") // "UPCOMING" | "LIVE" | "CONCLUDED" | "CANCELLED"
  createdAt   DateTime  @default(now())

  @@index([guildId])
}

model AutomationRule {
  id        String   @id @default(uuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  trigger   String   // MEMBER_JOIN | MEMBER_LEAVE | ROLE_ADDED | ROLE_REMOVED | TICKET_CREATED | TICKET_CLOSED | TASK_CREATED | TASK_COMPLETED
  action    String   // SEND_MESSAGE | SEND_EMBED | ASSIGN_ROLE | REMOVE_ROLE | CREATE_TASK | CREATE_REMINDER | SEND_DM
  config    String   // JSON string configuration
  enabled   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, trigger, enabled])
}

// ─────────────────────────────────────────────────────────────────
// Audit Logging (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  action     String
  executorId String
  targetId   String?
  details    String?
  timestamp  DateTime @default(now())

  @@index([guildId])
  @@index([guildId, timestamp])
}

model DashboardAuditLog {
  id         String   @id @default(uuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  action     String   // "LOGIN" | "BOT_INSTALLED" | "SETTINGS_UPDATED" | "MODULE_TOGGLED" | "TICKET_ACTION" | "MODERATION_ACTION" | "EMBED_DISPATCH"
  executorId String   // Discord user ID
  targetId   String?
  targetType String?  // "CHANNEL" | "USER" | "ROLE" | "TICKET" | "MODULE"
  details    String?  // JSON metadata
  ipAddress  String?
  source     String   @default("DASHBOARD") // "DASHBOARD" | "BOT"
  timestamp  DateTime @default(now())

  @@index([guildId])
  @@index([executorId])
  @@index([guildId, timestamp])
}

// ─────────────────────────────────────────────────────────────────
// Engagement & Feedback (Guild-Scoped)
// ─────────────────────────────────────────────────────────────────

model Poll {
  id          String    @id @default(uuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  question    String
  options     String    // JSON string array of options: [{ text, votes }]
  channelId   String
  messageId   String?
  isAnonymous Boolean   @default(false)
  expiresAt   DateTime?
  status      String    @default("ACTIVE") // ACTIVE | CLOSED
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([guildId])
  @@index([guildId, status])
}

model Suggestion {
  id            String   @id @default(uuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  authorId      String
  title         String
  content       String
  status        String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | IMPLEMENTED
  reviewerNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, status])
}

model DashboardNotification {
  id        String   @id @default(uuid())
  userId    String   // Discord user ID
  type      String   // TICKET | TASK | MEETING | REMINDER | MODERATION | SYSTEM
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
