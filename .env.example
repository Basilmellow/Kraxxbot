# ============================================================
# KRAXX HQ - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# NEVER commit real tokens, keys, or passwords to git.
# Copy this file to .env and fill in the actual Discord IDs.

# ------------------------------------------------------------
# DISCORD BOT APPLICATION CREDENTIALS
# ------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# ------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------
# For SQLite (local dev): file:./dev.db
# For PostgreSQL (production): postgresql://user:password@localhost:5432/kraxx_hq?schema=public
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# SYSTEM ENVIRONMENT & LOGGING
# ------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# ------------------------------------------------------------
# ORGANIZATIONAL ROLE DISCORD IDs
# ------------------------------------------------------------
# Hierarchy order: Founder -> Co-Founder -> Management Head -> Team Lead -> Partner -> Division Roles -> Client -> User
FOUNDER_ROLE_ID=
COFOUNDER_ROLE_ID=
MANAGEMENT_ROLE_ID=
TEAM_LEAD_ROLE_ID=
PARTNER_ROLE_ID=
KRAXXSEC_ROLE_ID=
KRAXXSTUDIO_ROLE_ID=
CLIENT_ROLE_ID=
USER_ROLE_ID=
KRAXX_BOT_ROLE_ID=

# ------------------------------------------------------------
# DISCORD CHANNEL DISCORD IDs
# ------------------------------------------------------------
# Onboarding & Verification
WELCOME_CHANNEL_ID=
VERIFY_CHANNEL_ID=

# HQ Central Communications
ANNOUNCEMENTS_CHANNEL_ID=
EVENTS_CHANNEL_ID=
KRAXX_GENERAL_CHANNEL_ID=
KRAXX_SUPPORT_CHANNEL_ID=

# Division: KRAXXSEC (Cybersecurity & Security Engineering)
SEC_ANNOUNCEMENTS_CHANNEL_ID=
SEC_GENERAL_CHANNEL_ID=
SEC_PROJECTS_CHANNEL_ID=
SEC_RESEARCH_CHANNEL_ID=

# Division: KRAXX STUDIO (Digital Creative / Technology Services)
STUDIO_ANNOUNCEMENTS_CHANNEL_ID=
STUDIO_GENERAL_CHANNEL_ID=
STUDIO_PROJECTS_CHANNEL_ID=
STUDIO_WORK_CHANNEL_ID=

# Operations Management & Tracking
HQ_DASHBOARD_CHANNEL_ID=
TASKS_CHANNEL_ID=
MEETINGS_CHANNEL_ID=
REMINDERS_CHANNEL_ID=
PENDING_CHANNEL_ID=
APPROVALS_CHANNEL_ID=

# External Client Communications
CLIENTS_GENERAL_CHANNEL_ID=

# Administration & Security Logs
MANAGEMENT_ZONE_CHANNEL_ID=
MODERATOR_ONLY_CHANNEL_ID=
SAFETY_UPDATES_CHANNEL_ID=
